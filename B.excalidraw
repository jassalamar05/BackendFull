    {
      "id": "-JhAqdGNE4ejKwb4-mGyc",
      "type": "text",
      "x": -174.91040346171985,
      "y": 11009.668444769148,
      "width": 1745.2349067624336,
      "height": 296.1038513002363,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
