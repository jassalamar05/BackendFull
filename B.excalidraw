      "updated": 1790084808436,
      "link": null,
      "locked": false,
      "text": "Yaad rakho:\n\nCORS configuration → Server par hoti hai\nCORS enforcement/check → Browser karta hai",
      "fontSize": 64.21527099609365,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Yaad rakho:\n\nCORS configuration → Server par hoti hai\nCORS enforcement/check → Browser karta hai",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "JZQb69MQL59BYkf1j9DuU",
      "type": "text",
      "x": 4479.934565589542,
      "y": 8252.2079638574,
      "width": 816.19970703125,
      "height": 245,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1A",
      "roundness": null,
      "seed": 2013679749,
      "version": 50,
      "versionNonce": 1535640619,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790084878591,
      "link": null,
      "locked": false,
      "text": "const cors = require(\"cors\");\n\napp.use(cors({\n    origin: \"*\",\n    methods: [\"GET\", \"PUT\", \"POST\", \"DELETE\"],\n    allowedHeaders: [\"Content-Type\", \"Authorization\"]\n}));",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "const cors = require(\"cors\");\n\napp.use(cors({\n    origin: \"*\",\n    methods: [\"GET\", \"PUT\", \"POST\", \"DELETE\"],\n    allowedHeaders: [\"Content-Type\", \"Authorization\"]\n}));",
      "autoResize": true,
      "lineHeight": 1.25
    },
