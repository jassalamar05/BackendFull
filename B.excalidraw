    {
      "id": "MIMTYD-NHhw1BkxY-CA-0",
      "type": "text",
      "x": -179.06860238290506,
      "y": 3921.7955736935387,
      "width": 1414.5792236328125,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
