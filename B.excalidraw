    {
      "id": "uPLLXBQakG25lKR2TebfJ",
      "type": "text",
      "x": -195.37722390384198,
      "y": 6928.4356908100435,
      "width": 674.3795776367188,
      "height": 100,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
