    {
      "id": "D9g-jZbBwRKtsRM-P_puU",
      "type": "text",
      "x": 2626.4799041748047,
      "y": 6295.8331578572615,
      "width": 1418.651611328125,
      "height": 3150,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0O",
