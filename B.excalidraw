      "text": "                  ENVIRONMENT CONFIGURATION\n                           │\n                           ▼\n                         .env\n                           │\n                  stores configuration\n                           │\n                           ▼\n                        dotenv\n                           │\n                     loads values\n                           │\n                           ▼\n                      process.env\n                           │\n                  application accesses\n                           │\n          ┌────────────────┼────────────────┐\n          ▼                ▼                ▼\n     Default Values   Type Conversion     NODE_ENV\n                                              │\n                              ┌───────────────┼──────────────┐\n                              ▼               ▼              ▼\n                         development      production       test",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "                  ENVIRONMENT CONFIGURATION\n                           │\n                           ▼\n                         .env\n                           │\n                  stores configuration\n                           │\n                           ▼\n                        dotenv\n                           │\n                     loads values\n                           │\n                           ▼\n                      process.env\n                           │\n                  application accesses\n                           │\n          ┌────────────────┼────────────────┐\n          ▼                ▼                ▼\n     Default Values   Type Conversion     NODE_ENV\n                                              │\n                              ┌───────────────┼──────────────┐\n                              ▼               ▼              ▼\n                         development      production       test",
      "autoResize": true,
      "lineHeight": 1.25
    },
