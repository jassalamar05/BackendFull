    {
      "id": "MbDRfeJ5tPAGn0iK3RCEz",
      "type": "text",
      "x": 2222.7786374773314,
      "y": 15520.515892299314,
      "width": 431.1998291015625,
      "height": 420,
      "angle": 0,
