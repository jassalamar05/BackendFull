    {
      "id": "CePv8_vKHw80PIiELhzQH",
      "type": "text",
      "x": 252.043212890625,
      "y": 231.83335876464844,
      "width": 991.2193603515625,
      "height": 375,
      "angle": 0,
      "strokeColor": "#f08c00",
