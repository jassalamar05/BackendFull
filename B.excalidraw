      "updated": 1790083821020,
      "link": null,
      "locked": false,
      "text": "this is why we shift towards express ??\n\nconst express = require(\"express\")\n\n\n\n\n\n\n\n\n\n\nconst app= express()\n\n\n\n\n\n\n\n\n\n\n\n\napp.use /listem / route",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "this is why we shift towards express ??\n\nconst express = require(\"express\")\n\n\n\n\n\n\n\n\n\n\nconst app= express()\n\n\n\n\n\n\n\n\n\n\n\n\napp.use /listem / route",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "84LM2NJi-gwM3zaYTV5Pm",
      "type": "text",
      "x": 4547.538236345564,
      "y": 4024.065651754542,
      "width": 1855.7479553222654,
      "height": 105,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
