    {
      "id": "5VdZmvbiHR9mQPDe4Xyma",
      "type": "text",
      "x": -206.71170296410037,
      "y": 6428.30178786361,
      "width": 1082.039306640625,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
