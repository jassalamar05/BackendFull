    {
      "id": "xkPa9TimQCXpkbna0b2zn",
      "type": "text",
      "x": -173.65291019589517,
      "y": 4488.689101914507,
      "width": 1530.6190185546875,
      "height": 1675,
      "angle": 0,
      "strokeColor": "#fa5252",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aj",
