      "seed": 90994953,
      "version": 89,
      "versionNonce": 1801567143,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789817955148,
      "link": null,
      "locked": false,
      "text": "Node ke andar enviroment kasie set krte haio woh dekhao okay \n\npackage.json\n{\n  \"scripts\": {\n    \"dev\": \"cross-env NODE_ENV=development nodemon Server.js\",\n    \"start\": \"cross-env NODE_ENV=production node Server.js\"\n  }\n}\n\n\nServer.js\nconst express = require(\"express\");\nconst dotenv = require(\"dotenv\");\nconst path = require(\"path\");\n\n// 1. Environment decide karo\nconst envFile =\n    process.env.NODE_ENV === \"production\"\n        ? \".env.production\"\n        : \".env.local\";\n\n// 2. Selected .env file load karo\ndotenv.config({\n    path: path.resolve(process.cwd(), envFile)\n});\n\n// 3. Check\nconsole.log(\"Environment:\", process.env.NODE_ENV);\nconsole.log(\"Port:\", process.env.PORT);\n\nconst app = express();\n\nconst PORT = process.env.PORT || 5000;\n\napp.listen(PORT, () => {\n    console.log(`Server running on ${PORT}`);\n});\n\n\n\n\n.env.local\nNODE_ENV=development\nPORT=8000\nMONGO_URI=mongodb://localhost:27017/local\n\n\n.env.production\nNODE_ENV=production\nPORT=8000\nMONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/production\nFlow\n\n\n\nnpm run dev\n      ↓\nNODE_ENV=development\n      ↓\n.env.local\n      ↓\nLocal MongoDB\nnpm run start\n      ↓\nNODE_ENV=production\n      ↓\n.env.production\n      ↓\nMongoDB Atlas",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Node ke andar enviroment kasie set krte haio woh dekhao okay \n\npackage.json\n{\n  \"scripts\": {\n    \"dev\": \"cross-env NODE_ENV=development nodemon Server.js\",\n    \"start\": \"cross-env NODE_ENV=production node Server.js\"\n  }\n}\n\n\nServer.js\nconst express = require(\"express\");\nconst dotenv = require(\"dotenv\");\nconst path = require(\"path\");\n\n// 1. Environment decide karo\nconst envFile =\n    process.env.NODE_ENV === \"production\"\n        ? \".env.production\"\n        : \".env.local\";\n\n// 2. Selected .env file load karo\ndotenv.config({\n    path: path.resolve(process.cwd(), envFile)\n});\n\n// 3. Check\nconsole.log(\"Environment:\", process.env.NODE_ENV);\nconsole.log(\"Port:\", process.env.PORT);\n\nconst app = express();\n\nconst PORT = process.env.PORT || 5000;\n\napp.listen(PORT, () => {\n    console.log(`Server running on ${PORT}`);\n});\n\n\n\n\n.env.local\nNODE_ENV=development\nPORT=8000\nMONGO_URI=mongodb://localhost:27017/local\n\n\n.env.production\nNODE_ENV=production\nPORT=8000\nMONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/production\nFlow\n\n\n\nnpm run dev\n      ↓\nNODE_ENV=development\n      ↓\n.env.local\n      ↓\nLocal MongoDB\nnpm run start\n      ↓\nNODE_ENV=production\n      ↓\n.env.production\n      ↓\nMongoDB Atlas",
      "autoResize": true,
      "lineHeight": 1.25
    },
